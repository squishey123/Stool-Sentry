    <string name="welcome_subtitle">A private, elegant log of every royal visit.</string>
    <string name="welcome_private_title">Private by design</string>
    <string name="welcome_private_body">Your logs stay on this phone. No account, no ads, and no internet access.</string>
    <string name="welcome_doctor_title">A log, not a doctor</string>
    <string name="welcome_doctor_body">Stool Sentry records patterns. It doesn\'t diagnose anything. Talk to a clinician about anything that worries you.</string>
    <string name="welcome_backup_title">Back up with a passphrase</string>
    <string name="welcome_backup_body">You can encrypt logs and backups with a passphrase you choose. Skip it, and turn it on later in Settings. Uninstalling the app deletes the logs on this phone.</string>
    <string name="welcome_accept">I understand</string>
    <string name="disclaimer_title">A log, not a doctor</string>
    <string name="disclaimer_body">Stool Sentry is a personal record. It is not a medical device and does not diagnose, treat, or prevent any condition. The summary\'s notes are general information only. If you notice blood, black or maroon stool, ongoing changes, or pain, talk to a qualified clinician. In an emergency, contact local emergency services.</string>

